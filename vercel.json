{
  "rewrites": [
    {"source":"/invite","destination":"/guest.html"},
    {"source":"/i/:token*","destination":"/guest.html"}
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
    },
    {
      "source": "/js/app.js",
      "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
    },
    {
      "source": "/js/guest.js",
      "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
    }
  ]
}
